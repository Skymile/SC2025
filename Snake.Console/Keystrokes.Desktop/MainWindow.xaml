<Window x:Class="Keystrokes.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Keystrokes.Desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid RowDefinitions="*,*">
        <TextBox 
            Grid.Row="0"
            FontSize="32" TextWrapping="Wrap" 
            PreviewKeyDown="TextBox_KeyDown" 
            PreviewKeyUp="TextBox_KeyUp"
            />
        <TextBox 
            Grid.Row="1"
            FontSize="32" TextWrapping="Wrap" Text="{Binding MainText}"/>
    </Grid>
</Window>
