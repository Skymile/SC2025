<Window x:Class="Casino.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Casino.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Vertical" Margin="10">
            <Label Width="192" Height="64" 
                   Background="Green" 
                   Foreground="White"
                   Content="0"
                   FontSize="32"
                   Margin="1"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                       />
            <UniformGrid Columns="3" 
                         Name="GridRoulette"
                         VerticalAlignment="Top"/>
        </StackPanel>
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal">
                <Button 
                    FontSize="32"
                    Width="192"
                    Content="Place Bet"
                    IsEnabled="{Binding IsBetPlacingAllowed}"
                    BorderThickness="0"
                    Margin="10"
                    Padding="10"
                    Command="{Binding BetPlacedCommand}"/>
                <Label 
                    FontSize="32"
                    Margin="10"
                    Padding="10"
                    VerticalAlignment="Center"
                    Content="{Binding CapitalLeft}"
                    Foreground="{Binding CapitalLeftColor}"
                       />
                <Slider 
                    Margin="10"
                    Padding="10"
                    VerticalAlignment="Center"
                    Width="250"
                    Minimum="100" Maximum="10000" 
                    Value="{Binding BetAmount}" />
                <Label Content="{Binding BetAmount}" FontSize="32"/>
            </StackPanel>
            <TextBox 
                Margin="10"
                x:Name="MainTextBox"
                Grid.Row="1"
                FontSize="32"
                TextWrapping="Wrap"
                />
        </Grid>
    </Grid>
</Window>
